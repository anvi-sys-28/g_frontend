{
  "name": "@cricket/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "postinstall": "node node_modules/prisma/build/index.js generate || prisma generate",
    "build": "node node_modules/prisma/build/index.js generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start -p 3001",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@tanstack/react-query": "^5.66.9",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "framer-motion": "^14.2.0",
    "ioredis": "^5.5.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "prisma": "^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true
  }
}
